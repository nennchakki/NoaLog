<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══ 「静謐な観測者」カラーパレット ═══ -->
  <!-- 生塩ノア（ブルーアーカイブ）の美学: 白・ミニマリスト・静か -->

  <!-- Background Colors -->
  <SolidColorBrush x:Key="BgLight" Color="#F0F4F8" />        <!-- 微かなブルーグレー サブ背景 -->
  <SolidColorBrush x:Key="BgDark" Color="#1B2A4A" />         <!-- 深い紺 ヘッダー -->
  <SolidColorBrush x:Key="BgPanel" Color="#FFFFFF" />         <!-- 純白 メイン背景 -->
  <SolidColorBrush x:Key="BgHover" Color="#F0F4F8" />         <!-- ホバー時 -->
  <SolidColorBrush x:Key="BgSelected" Color="#E8F4FB" />      <!-- 選択時 -->
  <SolidColorBrush x:Key="BgInput" Color="#F8F9FA" />         <!-- 入力フィールド -->
  <SolidColorBrush x:Key="BgSurface" Color="#F8F9FA" />       <!-- カード表面 -->

  <!-- Text Colors -->
  <SolidColorBrush x:Key="TextPrimary" Color="#2C2C2C" />     <!-- ほぼ黒 メインテキスト -->
  <SolidColorBrush x:Key="TextSecondary" Color="#8C8C8C" />   <!-- グレー サブテキスト -->
  <SolidColorBrush x:Key="TextTertiary" Color="#ABABAB" />    <!-- 薄いグレー -->
  <SolidColorBrush x:Key="TextOnDark" Color="#F0F4F8" />      <!-- ダーク背景上 -->
  <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />    <!-- アクセント背景上 -->

  <!-- Accent: ノアの瞳色 アイスブルー -->
  <SolidColorBrush x:Key="Accent" Color="#7EC8E3" />
  <SolidColorBrush x:Key="AccentLight" Color="#B8E0F0" />     <!-- ミレニアム淡い水色 -->
  <SolidColorBrush x:Key="AccentDark" Color="#5BB5D6" />
  <SolidColorBrush x:Key="AccentBg" Color="#E8F4FB" />        <!-- アクセント背景 -->
  <SolidColorBrush x:Key="AccentPressed" Color="#4AA3C4" />
  <SolidColorBrush x:Key="AccentSubtle" Color="#B8E0F0" />    <!-- サブアクセント -->

  <!-- Border Colors — 最小限、余白で区切る -->
  <SolidColorBrush x:Key="BorderDefault" Color="#E8ECF0" />
  <SolidColorBrush x:Key="BorderInput" Color="#DDE2E8" />
  <SolidColorBrush x:Key="BorderWarm" Color="#E8ECF0" />
  <SolidColorBrush x:Key="BorderInputWarm" Color="#DDE2E8" />
  <SolidColorBrush x:Key="BorderSubtle" Color="#F0F2F5" />    <!-- ごく薄い区切り -->

  <!-- Semantic Colors — 抑えたトーン -->
  <SolidColorBrush x:Key="Success" Color="#7EC8A0" />         <!-- 落ち着いた緑 -->
  <SolidColorBrush x:Key="Warning" Color="#E8C87E" />         <!-- 柔らかな黄 -->
  <SolidColorBrush x:Key="Error" Color="#D4A0A0" />           <!-- ロゼ -->

  <!-- Badge Colors -->
  <SolidColorBrush x:Key="BadgeEditedBg" Color="#E8F4FB" />
  <SolidColorBrush x:Key="BadgeEditedText" Color="#5BB5D6" />
  <SolidColorBrush x:Key="BadgeNarrationBg" Color="#F0F4F8" />
  <SolidColorBrush x:Key="BadgeNarrationText" Color="#8C8C8C" />
  <SolidColorBrush x:Key="BadgeWarningBg" Color="#FBF5E8" />
  <SolidColorBrush x:Key="BadgeWarningText" Color="#C8A050" />

  <!-- Scrollbar Colors -->
  <SolidColorBrush x:Key="ScrollbarBg" Color="#F0F2F5" />
  <SolidColorBrush x:Key="ScrollbarHandle" Color="#DDE2E8" />
  <SolidColorBrush x:Key="ScrollbarHandleHover" Color="#C8D0D8" />

  <!-- Overlay Colors -->
  <Color x:Key="OverlayBgColor">#4D1B2A4A</Color>             <!-- 30% opacity 深紺 -->
  <SolidColorBrush x:Key="OverlaySelection" Color="#7EC8E3" />
  <Color x:Key="OverlaySelectionFillColor">#337EC8E3</Color>   <!-- 20% opacity -->
  <SolidColorBrush x:Key="OverlayConfirmed" Color="#7EC8A0" />

  <!-- Disabled -->
  <SolidColorBrush x:Key="DisabledBg" Color="#E8ECF0" />
  <SolidColorBrush x:Key="DisabledText" Color="#ABABAB" />

  <!-- ═══ Typography ═══ -->
  <!-- Noto Sans JP Light 基本、見出しのみ Regular -->
  <FontFamily x:Key="DefaultFont">Noto Sans JP, Hiragino Sans, Yu Gothic UI, Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
  <FontFamily x:Key="MonoFont">SF Mono, Consolas, Noto Sans Mono CJK JP, monospace</FontFamily>

  <!-- Font Sizes — 控えめ、情報密度を高く -->
  <x:Double x:Key="FontXs">10</x:Double>
  <x:Double x:Key="FontSm">11</x:Double>
  <x:Double x:Key="FontBase">13</x:Double>
  <x:Double x:Key="FontLg">15</x:Double>
  <x:Double x:Key="FontXl">17</x:Double>
  <x:Double x:Key="Font2xl">22</x:Double>

  <!-- Corner Radius — 控えめ (4px 基本) -->
  <CornerRadius x:Key="RadiusSm">3</CornerRadius>
  <CornerRadius x:Key="RadiusMd">4</CornerRadius>
  <CornerRadius x:Key="RadiusLg">6</CornerRadius>
  <CornerRadius x:Key="RadiusXl">8</CornerRadius>
  <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

  <!-- Layout Constants -->
  <x:Double x:Key="HeaderHeight">48</x:Double>

  <!-- Animation Durations -->
  <x:String x:Key="DurationFast">0:0:0.15</x:String>
  <x:String x:Key="DurationNormal">0:0:0.2</x:String>
  <x:String x:Key="DurationSlow">0:0:0.3</x:String>

</ResourceDictionary>
