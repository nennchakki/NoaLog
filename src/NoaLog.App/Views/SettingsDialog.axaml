<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NoaLog.App.Views.SettingsDialog"
        Title="Settings"
        Width="560" Height="680"
        MinWidth="480" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource BgLight}"
        FontFamily="{DynamicResource DefaultFont}">

    <DockPanel LastChildFill="True">

        <!-- ═══ Header (fixed, dark) ═══ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgDark}"
                Padding="24,16">
            <TextBlock Text="Settings"
                       FontSize="{DynamicResource FontXl}"
                       FontWeight="Light"
                       Foreground="{DynamicResource TextOnDark}" />
        </Border>

        <!-- ═══ Footer (fixed, white) ═══ -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <Grid ColumnDefinitions="Auto,*,Auto,8,Auto">
                <Button Grid.Column="0"
                        Name="EulaButton"
                        Content="利用規約"
                        MinWidth="100" Height="40"
                        Background="Transparent"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource BorderInputWarm}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSm}"
                        Padding="16,8"
                        FontSize="{DynamicResource FontBase}"
                        HorizontalContentAlignment="Center"
                        Cursor="Hand"
                        Click="OnEulaClick" />
                <Button Grid.Column="2"
                        Name="CancelButton"
                        Content="Cancel"
                        MinWidth="100" Height="40"
                        Background="Transparent"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource BorderInputWarm}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSm}"
                        Padding="16,8"
                        FontSize="{DynamicResource FontBase}"
                        HorizontalContentAlignment="Center"
                        Cursor="Hand"
                        Click="OnCancelClick" />
                <Button Grid.Column="4"
                        Name="SaveButton"
                        Content="Save"
                        MinWidth="100" Height="40"
                        Background="{DynamicResource Accent}"
                        Foreground="{DynamicResource TextOnAccent}"
                        BorderThickness="0"
                        CornerRadius="{DynamicResource RadiusSm}"
                        Padding="16,8"
                        FontSize="{DynamicResource FontBase}"
                        FontWeight="SemiBold"
                        HorizontalContentAlignment="Center"
                        Cursor="Hand"
                        Click="OnSaveClick" />
            </Grid>
        </Border>

        <!-- ═══ Scrollable Content ═══ -->
        <ScrollViewer Background="{DynamicResource BgLight}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0" Margin="16">

                <!-- ═══ Section 1: Keybinds ═══ -->
                <Border Background="{DynamicResource BgPanel}"
                        BorderBrush="{DynamicResource BorderWarm}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Keybinds"
                                   FontSize="{DynamicResource FontLg}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Click the input field and press a key combination to set the hotkey."
                                   FontSize="{DynamicResource FontSm}"
                                   Foreground="{DynamicResource TextSecondary}" />

                        <!-- Region Hotkey -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Region Hotkey"
                                       FontWeight="Bold"
                                       FontSize="{DynamicResource FontBase}"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <Grid ColumnDefinitions="*,8,Auto">
                                <TextBox Grid.Column="0"
                                         Name="RegionHotkeyBox"
                                         IsReadOnly="True"
                                         Watermark="Press keys..."
                                         MinHeight="36"
                                         Background="{DynamicResource BgInput}"
                                         BorderBrush="{DynamicResource BorderInputWarm}"
                                         BorderThickness="1"
                                         CornerRadius="{DynamicResource RadiusSm}"
                                         Padding="10,8"
                                         FontSize="{DynamicResource FontBase}"
                                         FontFamily="{DynamicResource MonoFont}"
                                         Cursor="Hand"
                                         KeyDown="OnRegionHotkeyKeyDown" />
                                <Button Grid.Column="2"
                                        Content="Clear"
                                        Width="80" Height="36"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextSecondary}"
                                        BorderBrush="{DynamicResource BorderInputWarm}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSm}"
                                        FontSize="{DynamicResource FontSm}"
                                        Cursor="Hand"
                                        Click="OnClearRegionHotkey" />
                            </Grid>
                        </StackPanel>

                        <!-- Capture Hotkey -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Capture Hotkey"
                                       FontWeight="Bold"
                                       FontSize="{DynamicResource FontBase}"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <Grid ColumnDefinitions="*,8,Auto">
                                <TextBox Grid.Column="0"
                                         Name="CaptureHotkeyBox"
                                         IsReadOnly="True"
                                         Watermark="Press keys..."
                                         MinHeight="36"
                                         Background="{DynamicResource BgInput}"
                                         BorderBrush="{DynamicResource BorderInputWarm}"
                                         BorderThickness="1"
                                         CornerRadius="{DynamicResource RadiusSm}"
                                         Padding="10,8"
                                         FontSize="{DynamicResource FontBase}"
                                         FontFamily="{DynamicResource MonoFont}"
                                         Cursor="Hand"
                                         KeyDown="OnCaptureHotkeyKeyDown" />
                                <Button Grid.Column="2"
                                        Content="Clear"
                                        Width="80" Height="36"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextSecondary}"
                                        BorderBrush="{DynamicResource BorderInputWarm}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSm}"
                                        FontSize="{DynamicResource FontSm}"
                                        Cursor="Hand"
                                        Click="OnClearCaptureHotkey" />
                            </Grid>
                        </StackPanel>

                        <!-- Narrator Hotkey -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Narrator Hotkey"
                                       FontWeight="Bold"
                                       FontSize="{DynamicResource FontBase}"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <Grid ColumnDefinitions="*,8,Auto">
                                <TextBox Grid.Column="0"
                                         Name="NarratorHotkeyBox"
                                         IsReadOnly="True"
                                         Watermark="Press keys..."
                                         MinHeight="36"
                                         Background="{DynamicResource BgInput}"
                                         BorderBrush="{DynamicResource BorderInputWarm}"
                                         BorderThickness="1"
                                         CornerRadius="{DynamicResource RadiusSm}"
                                         Padding="10,8"
                                         FontSize="{DynamicResource FontBase}"
                                         FontFamily="{DynamicResource MonoFont}"
                                         Cursor="Hand"
                                         KeyDown="OnNarratorHotkeyKeyDown" />
                                <Button Grid.Column="2"
                                        Content="Clear"
                                        Width="80" Height="36"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextSecondary}"
                                        BorderBrush="{DynamicResource BorderInputWarm}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSm}"
                                        FontSize="{DynamicResource FontSm}"
                                        Cursor="Hand"
                                        Click="OnClearNarratorHotkey" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ Section 2: 語り部設定 ═══ -->
                <Border Background="{DynamicResource BgPanel}"
                        BorderBrush="{DynamicResource BorderWarm}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="語り部設定"
                                   FontSize="{DynamicResource FontLg}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Ctrl+N でキャプチャした時の話者名を設定します。"
                                   FontSize="{DynamicResource FontSm}"
                                   Foreground="{DynamicResource TextSecondary}" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="語り部の名前"
                                       FontWeight="Bold"
                                       FontSize="{DynamicResource FontBase}"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBox Name="NarratorLabelBox"
                                     Watermark="語り部"
                                     MinHeight="36"
                                     Background="{DynamicResource BgInput}"
                                     BorderBrush="{DynamicResource BorderInputWarm}"
                                     BorderThickness="1"
                                     CornerRadius="{DynamicResource RadiusSm}"
                                     Padding="10,8"
                                     FontSize="{DynamicResource FontBase}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ Section 3: Inference Log ═══ -->
                <Border Background="{DynamicResource BgPanel}"
                        BorderBrush="{DynamicResource BorderWarm}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Inference Log"
                                   FontSize="{DynamicResource FontLg}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="推論処理のログをリアルタイムで表示します。"
                                   FontSize="{DynamicResource FontSm}"
                                   Foreground="{DynamicResource TextSecondary}" />

                        <ToggleSwitch Name="InferenceLogToggle"
                                      OnContent="ON"
                                      OffContent="OFF" />
                    </StackPanel>
                </Border>

                <!-- ═══ Section: Gemini モデル設定 ═══ -->
                <Border Background="{DynamicResource BgPanel}"
                        BorderBrush="{DynamicResource BorderWarm}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Gemini モデル設定"
                                   FontSize="{DynamicResource FontLg}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Gemini APIで使用するモデルを選択します。環境変数 GEMINI_API_KEY が必要です。"
                                   FontSize="{DynamicResource FontSm}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" />

                        <StackPanel Spacing="6">
                            <RadioButton Name="GeminiModel31FlashLite"
                                         GroupName="GeminiModel"
                                         IsChecked="True">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="gemini-3.1-flash-lite"
                                               VerticalAlignment="Center" />
                                    <Border Background="#128AFA"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="★ 推奨"
                                                   FontSize="10"
                                                   Foreground="White" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Name="GeminiModel25FlashLite"
                                         GroupName="GeminiModel">
                                <TextBlock Text="gemini-2.5-flash-lite" />
                            </RadioButton>
                            <RadioButton Name="GeminiModel25Pro"
                                         GroupName="GeminiModel">
                                <TextBlock Text="gemini-2.5-pro" />
                            </RadioButton>
                        </StackPanel>

                        <!-- APIキー状態 -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="APIキー:"
                                       FontSize="{DynamicResource FontBase}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Name="GeminiApiKeyStatus"
                                       FontSize="{DynamicResource FontBase}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>



            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</Window>
