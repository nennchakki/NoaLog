<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NoaLog.App.Controls.CopyPanel"
             MaxHeight="180">

  <Border Background="{DynamicResource BgLight}"
          BorderBrush="{DynamicResource BorderInput}"
          BorderThickness="1"
          CornerRadius="14"
          Padding="16">

    <StackPanel Spacing="12">

      <!-- Title -->
      <TextBlock Text="Copy"
                 FontFamily="{DynamicResource DefaultFont}"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimary}" />

      <!-- Format toggle buttons -->
      <StackPanel Orientation="Horizontal" Spacing="0">

        <!-- Plain -->
        <RadioButton Name="FormatPlain"
                     GroupName="CopyFormat"
                     IsChecked="True"
                     Content="Plain"
                     FontFamily="{DynamicResource DefaultFont}"
                     FontSize="13"
                     Padding="12,6"
                     MinWidth="56"
                     HorizontalContentAlignment="Center"
                     CornerRadius="6,0,0,6"
                     BorderThickness="1"
                     Classes="formatToggle" />

        <!-- MD -->
        <RadioButton Name="FormatMarkdown"
                     GroupName="CopyFormat"
                     Content="MD"
                     FontFamily="{DynamicResource DefaultFont}"
                     FontSize="13"
                     Padding="12,6"
                     MinWidth="56"
                     HorizontalContentAlignment="Center"
                     CornerRadius="0"
                     BorderThickness="1,1,1,1"
                     Classes="formatToggle" />

        <!-- JSON -->
        <RadioButton Name="FormatJson"
                     GroupName="CopyFormat"
                     Content="JSON"
                     FontFamily="{DynamicResource DefaultFont}"
                     FontSize="13"
                     Padding="12,6"
                     MinWidth="56"
                     HorizontalContentAlignment="Center"
                     CornerRadius="0,6,6,0"
                     BorderThickness="1"
                     Classes="formatToggle" />

      </StackPanel>

      <!-- Action buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8">

        <!-- Copy button -->
        <Button Name="CopyButton"
                Content="Copy"
                FontFamily="{DynamicResource DefaultFont}"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextOnAccent}"
                Background="{DynamicResource Accent}"
                CornerRadius="10"
                Padding="24,12"
                MinHeight="36"
                HorizontalContentAlignment="Center" />

        <!-- Export button -->
        <Button Name="ExportButton"
                Content="Export"
                FontFamily="{DynamicResource DefaultFont}"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextOnAccent}"
                Background="{DynamicResource Accent}"
                CornerRadius="10"
                Padding="24,12"
                MinHeight="36"
                HorizontalContentAlignment="Center" />

      </StackPanel>

    </StackPanel>

  </Border>

  <UserControl.Styles>

    <!-- Format toggle: unchecked state -->
    <Style Selector="RadioButton.formatToggle">
      <Setter Property="Background" Value="#FAFAFA" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderInputWarm}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Format toggle: hover (unchecked) -->
    <Style Selector="RadioButton.formatToggle:pointerover">
      <Setter Property="Background" Value="{DynamicResource BgHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLight}" />
    </Style>

    <!-- Format toggle: checked state -->
    <Style Selector="RadioButton.formatToggle:checked">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
    </Style>

    <!-- Copy/Export button hover -->
    <Style Selector="Button#CopyButton:pointerover, Button#ExportButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentDark}" />
    </Style>

    <!-- Copy/Export button pressed -->
    <Style Selector="Button#CopyButton:pressed, Button#ExportButton:pressed">
      <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
    </Style>

    <!-- Copy/Export button disabled -->
    <Style Selector="Button#CopyButton:disabled, Button#ExportButton:disabled">
      <Setter Property="Background" Value="{DynamicResource DisabledBg}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
    </Style>

  </UserControl.Styles>

</UserControl>
