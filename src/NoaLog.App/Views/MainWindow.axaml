<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NoaLog.App.ViewModels"
        xmlns:controls="using:NoaLog.App.Controls"
        x:Class="NoaLog.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="NoaLog"
        Width="1280" Height="800"
        MinWidth="1100" MinHeight="700">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- ═══ Header Bar (56px, #0B1B2B) ═══ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgDark}"
                Height="56">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,0">
                <!-- Halo Indicator -->
                <controls:HaloIndicator Name="HaloIndicator"
                                        Grid.Column="0"
                                        VerticalAlignment="Center" />

                <!-- Title -->
                <TextBlock Grid.Column="1"
                           Text="NoaLog"
                           Foreground="{DynamicResource TextOnDark}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />

                <!-- Hotkey Display -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="24">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Region:"
                                   Foreground="{DynamicResource TextTertiary}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Name="RegionHotkeyLabel"
                                   Text="⌃R"
                                   Foreground="{DynamicResource AccentLight}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Capture:"
                                   Foreground="{DynamicResource TextTertiary}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Name="CaptureHotkeyLabel"
                                   Text="⌃L"
                                   Foreground="{DynamicResource AccentLight}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Narrator:"
                                   Foreground="{DynamicResource TextTertiary}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Name="NarratorHotkeyLabel"
                                   Text="⌃N"
                                   Foreground="{DynamicResource AccentLight}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Settings Button -->
                <Button Name="SettingsButton"
                        Grid.Column="3"
                        Content="Settings"
                        Background="Transparent"
                        Foreground="{DynamicResource TextOnDark}"
                        BorderBrush="{DynamicResource Accent}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,6"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Click="OnSettingsClick" />
            </Grid>
        </Border>

        <!-- ═══ Status Bar (bottom) ═══ -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,1,0,0"
                Padding="16,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Name="StatusLabel"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                    <TextBlock Name="OcrEngineLabel"
                               Text="Engine: manga_ocr"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="12"
                               MinWidth="120"
                               VerticalAlignment="Center" />
                    <TextBlock Text="│"
                               Foreground="{DynamicResource BorderInput}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Name="LastCaptureLabel"
                               Text="Last: --:--:--"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="12"
                               MinWidth="100"
                               VerticalAlignment="Center" />
                    <TextBlock Text="│"
                               Foreground="{DynamicResource BorderInput}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Name="EntryCountLabel"
                               Text="0 entries"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="12"
                               MinWidth="80"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Main 3-Pane Layout ═══ -->
        <Grid ColumnDefinitions="240,1,*,1,360">

            <!-- ═══ Left Pane: Profile ═══ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="16">

                    <!-- Capture Button (bottom) -->
                    <Button Name="CaptureButton"
                            DockPanel.Dock="Bottom"
                            Classes="primary"
                            Content="Capture"
                            HorizontalAlignment="Stretch"
                            Margin="0,16,0,0"
                            Click="OnCaptureClick" />

                    <StackPanel Spacing="16">
                        <!-- Profile Section -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="PROFILE" />
                            <ComboBox Name="ProfileCombo"
                                      Classes="profileSelect"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Select profile..." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Name="NewProfileButton"
                                        Classes="secondary"
                                        Content="New"
                                        HorizontalAlignment="Stretch"
                                        Padding="16,8"
                                        Click="OnNewProfileClick" />
                                <Button Name="EditProfileButton"
                                        Classes="secondary"
                                        Content="Edit"
                                        HorizontalAlignment="Stretch"
                                        Padding="16,8"
                                        Click="OnEditProfileClick" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Stats Section -->
                        <Border Background="{DynamicResource BgLight}"
                                CornerRadius="10"
                                Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="sectionTitle" Text="STATISTICS" />
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            Margin="0,4,0,0">
                                    <TextBlock Name="StatCount"
                                               Text="0"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="entries"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,4" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Left Splitter -->
            <GridSplitter Grid.Column="1"
                          Background="{DynamicResource BorderDefault}"
                          ResizeDirection="Columns" />

            <!-- ═══ Center Pane: Log List ═══ -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BgLight}">
                <DockPanel Margin="16">
                    <!-- Search Bar -->
                    <TextBox DockPanel.Dock="Top"
                             Classes="search"
                             Watermark="Search logs..."
                             Margin="0,0,0,12" />

                    <!-- Log Entry List -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Name="LogList">
                            <!-- LogCards will be added here dynamically -->
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Right Splitter -->
            <GridSplitter Grid.Column="3"
                          Background="{DynamicResource BorderDefault}"
                          ResizeDirection="Columns" />

            <!-- ═══ Right Pane: Detail + Copy ═══ -->
            <Border Grid.Column="4"
                    Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- Copy Panel (bottom, max 180px) -->
                    <controls:CopyPanel DockPanel.Dock="Bottom" />

                    <!-- Separator -->
                    <Border DockPanel.Dock="Bottom"
                            Height="1"
                            Background="{DynamicResource BorderDefault}" />

                    <!-- Detail Panel (fills remaining space) -->
                    <controls:DetailPanel />
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>

</Window>
