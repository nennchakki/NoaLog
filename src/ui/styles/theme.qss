/*
 * NoaLog Theme - Noa-inspired Qt StyleSheet
 *
 * Color Palette:
 * - Background: #f8f8f5 (ivory/cream)
 * - Primary: #1a2744 (navy blue)
 * - Accent: #5eb3f0 (light blue)
 * - Text: #1a2744 (navy)
 * - Secondary Text: #6b7280 (gray)
 * - Border: #e5e5e0 (light gray)
 * - Error: #dc3545 (red)
 * - Success: #28a745 (green)
 */

/* === Global Styles === */
QWidget {
    background-color: #f8f8f5;
    color: #1a2744;
    font-family: "Hiragino Sans", "Noto Sans JP", "Yu Gothic UI", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #f8f8f5;
}

/* === Buttons === */
QPushButton {
    background-color: #1a2744;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    min-height: 32px;
}

QPushButton:hover {
    background-color: #2a3754;
}

QPushButton:pressed {
    background-color: #0a1734;
}

QPushButton:disabled {
    background-color: #c0c0c0;
    color: #808080;
}

QPushButton#primaryButton {
    background-color: #5eb3f0;
    color: #ffffff;
}

QPushButton#primaryButton:hover {
    background-color: #4ea3e0;
}

QPushButton#secondaryButton {
    background-color: transparent;
    color: #1a2744;
    border: 2px solid #1a2744;
}

QPushButton#secondaryButton:hover {
    background-color: #1a2744;
    color: #ffffff;
}

QPushButton#dangerButton {
    background-color: #dc3545;
}

QPushButton#dangerButton:hover {
    background-color: #c82333;
}

/* === Input Fields === */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 2px solid #e5e5e0;
    border-radius: 6px;
    padding: 8px 12px;
    color: #1a2744;
    selection-background-color: #5eb3f0;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #5eb3f0;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #f0f0f0;
    color: #808080;
}

/* === Labels === */
QLabel {
    color: #1a2744;
    background-color: transparent;
}

QLabel#titleLabel {
    font-size: 24px;
    font-weight: 700;
    color: #1a2744;
}

QLabel#subtitleLabel {
    font-size: 14px;
    color: #6b7280;
}

QLabel#errorLabel {
    color: #dc3545;
    font-size: 12px;
}

QLabel#successLabel {
    color: #28a745;
    font-size: 12px;
}

/* === ComboBox === */
QComboBox {
    background-color: #ffffff;
    border: 2px solid #e5e5e0;
    border-radius: 6px;
    padding: 8px 12px;
    min-height: 32px;
    color: #1a2744;
}

QComboBox:hover {
    border-color: #5eb3f0;
}

QComboBox:focus {
    border-color: #5eb3f0;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #1a2744;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 2px solid #e5e5e0;
    border-radius: 6px;
    selection-background-color: #5eb3f0;
    selection-color: #ffffff;
}

/* === SpinBox === */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 2px solid #e5e5e0;
    border-radius: 6px;
    padding: 8px 12px;
    min-height: 32px;
    color: #1a2744;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #5eb3f0;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #e5e5e0;
    border: none;
    width: 20px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #5eb3f0;
}

/* === CheckBox === */
QCheckBox {
    color: #1a2744;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #e5e5e0;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #5eb3f0;
}

QCheckBox::indicator:checked {
    background-color: #5eb3f0;
    border-color: #5eb3f0;
}

/* === RadioButton === */
QRadioButton {
    color: #1a2744;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #e5e5e0;
    border-radius: 9px;
    background-color: #ffffff;
}

QRadioButton::indicator:hover {
    border-color: #5eb3f0;
}

QRadioButton::indicator:checked {
    background-color: #5eb3f0;
    border-color: #5eb3f0;
}

/* === GroupBox === */
QGroupBox {
    font-weight: 600;
    border: 2px solid #e5e5e0;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px;
    padding-top: 24px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    color: #1a2744;
    background-color: #f8f8f5;
}

/* === TabWidget === */
QTabWidget::pane {
    border: 2px solid #e5e5e0;
    border-radius: 8px;
    background-color: #ffffff;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: #e5e5e0;
    color: #6b7280;
    border: none;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1a2744;
    border: 2px solid #e5e5e0;
    border-bottom: 2px solid #ffffff;
}

QTabBar::tab:hover:!selected {
    background-color: #d5d5d0;
}

/* === ListView / TreeView / TableView === */
QListView, QTreeView, QTableView {
    background-color: #ffffff;
    border: 2px solid #e5e5e0;
    border-radius: 8px;
    alternate-background-color: #fafaf7;
}

QListView::item, QTreeView::item, QTableView::item {
    padding: 8px;
    border-bottom: 1px solid #e5e5e0;
}

QListView::item:selected, QTreeView::item:selected, QTableView::item:selected {
    background-color: #5eb3f0;
    color: #ffffff;
}

QListView::item:hover, QTreeView::item:hover, QTableView::item:hover {
    background-color: #f0f8ff;
}

QHeaderView::section {
    background-color: #f8f8f5;
    color: #1a2744;
    font-weight: 600;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #e5e5e0;
}

/* === ScrollBar === */
QScrollBar:vertical {
    background-color: #f8f8f5;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 5px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #f8f8f5;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    border-radius: 5px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* === Menu === */
QMenuBar {
    background-color: #1a2744;
    color: #ffffff;
    padding: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 8px 12px;
}

QMenuBar::item:selected {
    background-color: #2a3754;
    border-radius: 4px;
}

QMenu {
    background-color: #ffffff;
    border: 2px solid #e5e5e0;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #5eb3f0;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #e5e5e0;
    margin: 4px 8px;
}

/* === ToolBar === */
QToolBar {
    background-color: #f8f8f5;
    border: none;
    border-bottom: 2px solid #e5e5e0;
    padding: 4px;
    spacing: 4px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 8px;
}

QToolButton:hover {
    background-color: #e5e5e0;
}

QToolButton:pressed {
    background-color: #d5d5d0;
}

/* === StatusBar === */
QStatusBar {
    background-color: #f8f8f5;
    border-top: 2px solid #e5e5e0;
    color: #6b7280;
}

QStatusBar::item {
    border: none;
}

/* === ProgressBar === */
QProgressBar {
    background-color: #e5e5e0;
    border: none;
    border-radius: 6px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #5eb3f0;
    border-radius: 6px;
}

/* === Slider === */
QSlider::groove:horizontal {
    height: 6px;
    background-color: #e5e5e0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #5eb3f0;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #4ea3e0;
}

/* === ToolTip === */
QToolTip {
    background-color: #1a2744;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
}

/* === Dialog === */
QDialog {
    background-color: #f8f8f5;
}

/* === Log Entry Styles (Custom) === */
QFrame#logEntryFrame {
    background-color: #ffffff;
    border: 2px solid #e5e5e0;
    border-radius: 8px;
    padding: 12px;
    margin: 4px;
}

QFrame#logEntryFrame:hover {
    border-color: #5eb3f0;
}

QLabel#speakerLabel {
    font-weight: 700;
    color: #1a2744;
    font-size: 14px;
}

QLabel#organizationLabel {
    color: #6b7280;
    font-size: 12px;
}

QLabel#timestampLabel {
    color: #a0a0a0;
    font-size: 11px;
}

/* === Capture Overlay === */
QFrame#captureOverlay {
    background-color: rgba(26, 39, 68, 0.3);
    border: 3px dashed #5eb3f0;
}

/* === Profile Card === */
QFrame#profileCard {
    background-color: #ffffff;
    border: 2px solid #e5e5e0;
    border-radius: 12px;
    padding: 16px;
}

QFrame#profileCard:hover {
    border-color: #5eb3f0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

QFrame#profileCardSelected {
    background-color: #f0f8ff;
    border: 2px solid #5eb3f0;
    border-radius: 12px;
    padding: 16px;
}

/* === Detail Panel === */
QFrame#detailPanel {
    background-color: #f8f8f5;
    border-left: 2px solid #e5e5e0;
}

/* === Sidebar === */
QFrame#sidebar {
    background-color: #f8f8f5;
    border-right: 2px solid #e5e5e0;
}
