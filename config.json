{
  "version": "0.1.0",
  "theme": "light",
  "language": "ja",
  "ocr": {
    "lang": "japan",
    "use_angle_cls": true,
    "use_gpu": false
  },
  "hotkey": {
    "debounce_ms": 100,
    "throttle_ms": 500,
    "capture": [
      "alt",
      "l"
    ],
    "region_selection": [
      "alt",
      "shift",
      "r"
    ],
    "narrator_capture": [
      "alt",
      "n"
    ]
  },
  "ui": {
    "font_size": 14,
    "window_width": 900,
    "window_height": 700,
    "skip_delete_confirmation": true
  },
  "copy": {
    "default_format": "plain",
    "include_timestamp": false
  }
}