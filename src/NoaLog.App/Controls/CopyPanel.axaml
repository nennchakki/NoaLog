<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NoaLog.App.Controls.CopyPanel"
             MaxHeight="160">

  <Border Background="{DynamicResource BgPanel}"
          Padding="16,12">

    <StackPanel Spacing="10">

      <!-- Title — 控えめ -->
      <TextBlock Text="COPY"
                 FontFamily="{DynamicResource DefaultFont}"
                 FontSize="{DynamicResource FontSm}"
                 FontWeight="Normal"
                 Foreground="{DynamicResource TextSecondary}"
                 LetterSpacing="1" />

      <!-- Format toggle buttons -->
      <StackPanel Orientation="Horizontal" Spacing="0">

        <!-- Plain -->
        <RadioButton Name="FormatPlain"
                     GroupName="CopyFormat"
                     IsChecked="True"
                     Content="Plain"
                     FontFamily="{DynamicResource DefaultFont}"
                     FontSize="{DynamicResource FontSm}"
                     FontWeight="Light"
                     Padding="12,5"
                     MinWidth="52"
                     HorizontalContentAlignment="Center"
                     CornerRadius="4,0,0,4"
                     BorderThickness="1"
                     Classes="formatToggle" />

        <!-- MD -->
        <RadioButton Name="FormatMarkdown"
                     GroupName="CopyFormat"
                     Content="MD"
                     FontFamily="{DynamicResource DefaultFont}"
                     FontSize="{DynamicResource FontSm}"
                     FontWeight="Light"
                     Padding="12,5"
                     MinWidth="52"
                     HorizontalContentAlignment="Center"
                     CornerRadius="0"
                     BorderThickness="1,1,1,1"
                     Classes="formatToggle" />

        <!-- JSON -->
        <RadioButton Name="FormatJson"
                     GroupName="CopyFormat"
                     Content="JSON"
                     FontFamily="{DynamicResource DefaultFont}"
                     FontSize="{DynamicResource FontSm}"
                     FontWeight="Light"
                     Padding="12,5"
                     MinWidth="52"
                     HorizontalContentAlignment="Center"
                     CornerRadius="0,4,4,0"
                     BorderThickness="1"
                     Classes="formatToggle" />

      </StackPanel>

      <!-- Action buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8">

        <!-- Copy button -->
        <Button Name="CopyButton"
                Content="Copy"
                FontFamily="{DynamicResource DefaultFont}"
                FontSize="{DynamicResource FontBase}"
                FontWeight="Normal"
                Foreground="{DynamicResource TextOnAccent}"
                Background="{DynamicResource Accent}"
                CornerRadius="{DynamicResource RadiusMd}"
                Padding="20,8"
                MinHeight="32"
                HorizontalContentAlignment="Center" />

        <!-- Export button -->
        <Button Name="ExportButton"
                Content="Export"
                FontFamily="{DynamicResource DefaultFont}"
                FontSize="{DynamicResource FontBase}"
                FontWeight="Light"
                Foreground="{DynamicResource Accent}"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderInput}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}"
                Padding="20,8"
                MinHeight="32"
                HorizontalContentAlignment="Center" />

      </StackPanel>

    </StackPanel>

  </Border>

  <UserControl.Styles>

    <!-- Format toggle: unchecked -->
    <Style Selector="RadioButton.formatToggle">
      <Setter Property="Background" Value="{DynamicResource BgInput}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderInput}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Format toggle: hover -->
    <Style Selector="RadioButton.formatToggle:pointerover">
      <Setter Property="Background" Value="{DynamicResource BgHover}" />
    </Style>

    <!-- Format toggle: checked -->
    <Style Selector="RadioButton.formatToggle:checked">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
    </Style>

    <!-- Copy button hover -->
    <Style Selector="Button#CopyButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentDark}" />
    </Style>
    <Style Selector="Button#CopyButton:pressed">
      <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
    </Style>

    <!-- Export button hover -->
    <Style Selector="Button#ExportButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource BgHover}" />
    </Style>

    <!-- Disabled -->
    <Style Selector="Button#CopyButton:disabled, Button#ExportButton:disabled">
      <Setter Property="Background" Value="{DynamicResource DisabledBg}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
    </Style>

  </UserControl.Styles>

</UserControl>
