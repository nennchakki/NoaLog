<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NoaLog.App.Views.SearchBar"
             IsVisible="False">

  <!-- 検索・置換バー本体 -->
  <Border BorderBrush="#E8ECF0"
          BorderThickness="0,0,0,1"
          CornerRadius="0"
          Padding="12,8">
    <Border.Background>
      <SolidColorBrush Color="#FFFFFF" Opacity="0.95" />
    </Border.Background>

    <StackPanel Spacing="6">

      <!-- 検索行 -->
      <Grid ColumnDefinitions="Auto,*,Auto">

        <!-- 置換展開トグル矢印 -->
        <Button Name="ExpandReplaceButton"
                Grid.Column="0"
                Content="▶"
                FontSize="10"
                Foreground="{DynamicResource TextSecondary}"
                Background="Transparent"
                BorderThickness="0"
                Padding="4,4"
                Width="24" Height="30"
                VerticalAlignment="Center"
                ToolTip.Tip="置換を表示"
                Click="OnExpandReplaceClick" />

        <!-- 検索入力 + 正規表現トグル -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">

          <!-- 検索テキストボックス -->
          <TextBox Name="SearchInput"
                   Watermark="検索..."
                   FontFamily="{DynamicResource DefaultFont}"
                   FontSize="{DynamicResource FontBase}"
                   FontWeight="Light"
                   Background="{DynamicResource BgInput}"
                   BorderBrush="{DynamicResource BorderInput}"
                   BorderThickness="1"
                   CornerRadius="{DynamicResource RadiusSm}"
                   Padding="8,4"
                   Width="260"
                   VerticalAlignment="Center" />

          <!-- 正規表現トグルボタン -->
          <ToggleButton Name="RegexToggle"
                        Content=".*"
                        FontFamily="{DynamicResource MonoFont}"
                        FontSize="{DynamicResource FontSm}"
                        Foreground="{DynamicResource TextSecondary}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSm}"
                        Padding="6,4"
                        Width="36" Height="30"
                        VerticalAlignment="Center"
                        ToolTip.Tip="正規表現 (Regex)" />

          <!-- マッチ数表示 -->
          <TextBlock Name="MatchCountLabel"
                     Text="0/0"
                     FontFamily="{DynamicResource DefaultFont}"
                     FontSize="{DynamicResource FontSm}"
                     Foreground="{DynamicResource TextSecondary}"
                     VerticalAlignment="Center"
                     MinWidth="40"
                     TextAlignment="Center" />

          <!-- 前へボタン (Shift+F3) -->
          <Button Name="PrevMatchButton"
                  Content="&#x25B2;"
                  FontSize="{DynamicResource FontXs}"
                  Foreground="{DynamicResource TextSecondary}"
                  Background="Transparent"
                  BorderBrush="{DynamicResource BorderDefault}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusSm}"
                  Padding="6,4"
                  Width="30" Height="30"
                  VerticalAlignment="Center"
                  ToolTip.Tip="前の一致 (Shift+F3)" />

          <!-- 次へボタン (F3) -->
          <Button Name="NextMatchButton"
                  Content="&#x25BC;"
                  FontSize="{DynamicResource FontXs}"
                  Foreground="{DynamicResource TextSecondary}"
                  Background="Transparent"
                  BorderBrush="{DynamicResource BorderDefault}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusSm}"
                  Padding="6,4"
                  Width="30" Height="30"
                  VerticalAlignment="Center"
                  ToolTip.Tip="次の一致 (F3)" />

        </StackPanel>

        <!-- 閉じるボタン -->
        <Button Name="CloseButton"
                Grid.Column="2"
                Content="&#x2715;"
                FontSize="{DynamicResource FontSm}"
                Foreground="{DynamicResource TextSecondary}"
                Background="Transparent"
                BorderThickness="0"
                Padding="6,4"
                Width="30" Height="30"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                ToolTip.Tip="閉じる (Escape)" />

      </Grid>

      <!-- 置換行（矢印クリックで展開） -->
      <StackPanel Name="ReplaceSection"
                  Orientation="Horizontal"
                  Spacing="6"
                  Margin="24,0,0,0"
                  IsVisible="False">

        <!-- 置換テキストボックス -->
        <TextBox Name="ReplaceInput"
                 Watermark="置換..."
                 FontFamily="{DynamicResource DefaultFont}"
                 FontSize="{DynamicResource FontBase}"
                 FontWeight="Light"
                 Background="{DynamicResource BgInput}"
                 BorderBrush="{DynamicResource BorderInput}"
                 BorderThickness="1"
                 CornerRadius="{DynamicResource RadiusSm}"
                 Padding="8,4"
                 Width="260"
                 VerticalAlignment="Center" />

        <!-- 置換ボタン (Enter) -->
        <Button Name="ReplaceButton"
                Content="置換 (Enter)"
                FontFamily="{DynamicResource DefaultFont}"
                FontSize="{DynamicResource FontSm}"
                Foreground="{DynamicResource TextOnAccent}"
                Background="{DynamicResource Accent}"
                BorderThickness="0"
                CornerRadius="{DynamicResource RadiusSm}"
                Padding="12,4"
                Height="30"
                HorizontalContentAlignment="Center"
                VerticalAlignment="Center" />

        <!-- すべて置換ボタン (Ctrl+Enter) -->
        <Button Name="ReplaceAllButton"
                Content="すべて置換 (Ctrl+Enter)"
                FontFamily="{DynamicResource DefaultFont}"
                FontSize="{DynamicResource FontSm}"
                Foreground="{DynamicResource Accent}"
                Background="{DynamicResource AccentLight}"
                BorderThickness="0"
                CornerRadius="{DynamicResource RadiusSm}"
                Padding="12,4"
                Height="30"
                HorizontalContentAlignment="Center"
                VerticalAlignment="Center" />

      </StackPanel>

    </StackPanel>

  </Border>

</UserControl>
