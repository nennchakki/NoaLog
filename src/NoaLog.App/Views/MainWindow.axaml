<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NoaLog.App.ViewModels"
        xmlns:controls="using:NoaLog.App.Controls"
        xmlns:views="using:NoaLog.App.Views"
        x:Class="NoaLog.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="NoaLog"
        Width="1280" Height="800"
        MinWidth="1100" MinHeight="700"
        Background="{DynamicResource BgLight}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- ═══ Header Bar — 深い紺、細いフォント ═══ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgDark}"
                Height="48">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="20,0">
                <!-- Halo Indicator -->
                <controls:HaloIndicator Name="HaloIndicator"
                                        Grid.Column="0"
                                        VerticalAlignment="Center" />

                <!-- Title — 細いウェイト -->
                <TextBlock Grid.Column="1"
                           Text="NoaLog"
                           Foreground="{DynamicResource TextOnDark}"
                           FontSize="{DynamicResource FontLg}"
                           FontWeight="Light"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />

                <!-- Hotkey Display -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="28">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Region"
                                   Foreground="{DynamicResource TextTertiary}"
                                   FontSize="{DynamicResource FontSm}"
                                   FontWeight="Light"
                                   VerticalAlignment="Center" />
                        <TextBlock Name="RegionHotkeyLabel"
                                   Text="⌃R"
                                   Foreground="{DynamicResource AccentLight}"
                                   FontSize="{DynamicResource FontSm}"
                                   FontWeight="Light"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Capture"
                                   Foreground="{DynamicResource TextTertiary}"
                                   FontSize="{DynamicResource FontSm}"
                                   FontWeight="Light"
                                   VerticalAlignment="Center" />
                        <TextBlock Name="CaptureHotkeyLabel"
                                   Text="⌃L"
                                   Foreground="{DynamicResource AccentLight}"
                                   FontSize="{DynamicResource FontSm}"
                                   FontWeight="Light"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Narrator"
                                   Foreground="{DynamicResource TextTertiary}"
                                   FontSize="{DynamicResource FontSm}"
                                   FontWeight="Light"
                                   VerticalAlignment="Center" />
                        <TextBlock Name="NarratorHotkeyLabel"
                                   Text="⌃N"
                                   Foreground="{DynamicResource AccentLight}"
                                   FontSize="{DynamicResource FontSm}"
                                   FontWeight="Light"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Settings Button — 控えめ -->
                <Button Name="SettingsButton"
                        Grid.Column="3"
                        Content="Settings"
                        Background="Transparent"
                        Foreground="{DynamicResource TextOnDark}"
                        BorderBrush="{DynamicResource AccentSubtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMd}"
                        Padding="14,5"
                        FontSize="{DynamicResource FontSm}"
                        FontWeight="Light"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Click="OnSettingsClick" />
            </Grid>
        </Border>

        <!-- ═══ Status Bar — 底部、薄い境界線 ═══ -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="20,3">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Name="StatusLabel"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextTertiary}"
                           FontSize="{DynamicResource FontXs}"
                           FontWeight="Light"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12">
                    <TextBlock Name="OcrEngineLabel"
                               Text="manga_ocr"
                               Foreground="{DynamicResource TextTertiary}"
                               FontSize="{DynamicResource FontXs}"
                               FontWeight="Light"
                               VerticalAlignment="Center" />
                    <TextBlock Text="·"
                               Foreground="{DynamicResource BorderDefault}"
                               FontSize="{DynamicResource FontXs}"
                               VerticalAlignment="Center" />
                    <TextBlock Name="LastCaptureLabel"
                               Text="--:--:--"
                               Foreground="{DynamicResource TextTertiary}"
                               FontSize="{DynamicResource FontXs}"
                               FontWeight="Light"
                               VerticalAlignment="Center" />
                    <TextBlock Text="·"
                               Foreground="{DynamicResource BorderDefault}"
                               FontSize="{DynamicResource FontXs}"
                               VerticalAlignment="Center" />
                    <TextBlock Name="EntryCountLabel"
                               Text="0 entries"
                               Foreground="{DynamicResource TextTertiary}"
                               FontSize="{DynamicResource FontXs}"
                               FontWeight="Light"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Main 3-Pane Layout ═══ -->
        <Grid ColumnDefinitions="220,1,*,1,340">

            <!-- ═══ Left Pane: Profile — 静かな白パネル ═══ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="20">

                    <!-- Capture Button -->
                    <Button Name="CaptureButton"
                            DockPanel.Dock="Bottom"
                            Classes="primary"
                            Content="Capture"
                            HorizontalAlignment="Stretch"
                            Margin="0,20,0,0"
                            Click="OnCaptureClick" />

                    <StackPanel Spacing="20">
                        <!-- Profile Section -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="PROFILE" />
                            <ComboBox Name="ProfileCombo"
                                      Classes="profileSelect"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Select profile..." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Name="NewProfileButton"
                                        Classes="secondary"
                                        Content="New"
                                        HorizontalAlignment="Stretch"
                                        Padding="14,6"
                                        Click="OnNewProfileClick" />
                                <Button Name="EditProfileButton"
                                        Classes="secondary"
                                        Content="Edit"
                                        HorizontalAlignment="Stretch"
                                        Padding="14,6"
                                        Click="OnEditProfileClick" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Stats Section -->
                        <Border Background="{DynamicResource BgLight}"
                                CornerRadius="{DynamicResource RadiusLg}"
                                Padding="14">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="sectionTitle" Text="STATISTICS" />
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            Margin="0,6,0,0">
                                    <TextBlock Name="StatCount"
                                               Text="0"
                                               FontSize="{DynamicResource Font2xl}"
                                               FontWeight="Light"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="entries"
                                               FontSize="{DynamicResource FontXs}"
                                               FontWeight="Light"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,3" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Left Splitter -->
            <GridSplitter Grid.Column="1"
                          Background="{DynamicResource BorderSubtle}"
                          ResizeDirection="Columns" />

            <!-- ═══ Center Pane: Log List ═══ -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BgLight}">
                <DockPanel Margin="16">
                    <!-- Search Bar (Ctrl+F / Ctrl+H で表示) -->
                    <views:SearchBar Name="SearchBar"
                                     DockPanel.Dock="Top"
                                     Margin="0,0,0,8" />

                    <!-- Log Entry List -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Name="LogList" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Right Splitter -->
            <GridSplitter Grid.Column="3"
                          Background="{DynamicResource BorderSubtle}"
                          ResizeDirection="Columns" />

            <!-- ═══ Right Pane: Detail + Copy ═══ -->
            <Border Grid.Column="4"
                    Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- Copy Panel -->
                    <controls:CopyPanel Name="CopyPanel" DockPanel.Dock="Bottom" />

                    <!-- Separator — ごく薄い線 -->
                    <Border DockPanel.Dock="Bottom"
                            Height="1"
                            Background="{DynamicResource BorderSubtle}" />

                    <!-- Detail Panel -->
                    <controls:DetailPanel Name="DetailPanel" />
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>

</Window>
