/*
 * NoaLog Theme - Noa Style
 * 生塩ノア（ミレニアム×セミナー書記）モチーフ
 * キーワード: 清潔、理性的、書記、監査、整然、透明感
 */

/* =============================================================================
   GLOBAL
   ============================================================================= */

* {
    font-family: "Hiragino Sans", "Noto Sans JP", "Yu Gothic UI", "Segoe UI", sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #F6F1E6;
}

QWidget {
    color: #121826;
}

/* =============================================================================
   HEADER FRAME (濃紺ヘッダー)
   ============================================================================= */

QFrame#headerFrame {
    background-color: #0B1B2B;
    border: none;
    min-height: 56px;
    max-height: 56px;
}

QFrame#headerFrame QLabel {
    color: #EAF2FF;
}

QFrame#headerFrame QLabel#appTitle {
    font-size: 18px;
    font-weight: 600;
    color: #FFFFFF;
}

QFrame#headerFrame QLabel#hotkeyLabel {
    font-size: 12px;
    color: #A7E4FF;
}

/* =============================================================================
   LEFT PANE (管理パネル)
   ============================================================================= */

QFrame#leftPane {
    background-color: #FFFFFF;
    border-right: 1px solid #E5EAF2;
}

QFrame#leftPane QLabel#sectionTitle {
    font-size: 12px;
    font-weight: 600;
    color: #5A6578;
    padding: 8px 16px 4px 16px;
}

/* Profile Selector */
QComboBox#profileSelector {
    background-color: #FAFAFA;
    border: 1px solid #C8D2E0;
    border-radius: 10px;
    padding: 8px 12px;
    min-height: 36px;
}

QComboBox#profileSelector:hover {
    border-color: #63C6FF;
}

QComboBox#profileSelector:focus {
    border-color: #63C6FF;
    background-color: #FFFFFF;
}

QComboBox#profileSelector::drop-down {
    border: none;
    width: 24px;
}

QComboBox#profileSelector QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #C8D2E0;
    border-radius: 10px;
    selection-background-color: #E5F4FF;
    selection-color: #121826;
}

/* Stats Panel */
QFrame#statsPanel {
    background-color: #F6F1E6;
    border-radius: 10px;
    padding: 12px;
}

QFrame#statsPanel QLabel {
    color: #5A6578;
    font-size: 12px;
}

QFrame#statsPanel QLabel#statValue {
    color: #121826;
    font-size: 16px;
    font-weight: 600;
}

/* =============================================================================
   CENTER PANE (ログタイムライン)
   ============================================================================= */

QFrame#centerPane {
    background-color: #F6F1E6;
}

/* Search Bar */
QLineEdit#searchInput {
    background-color: #FFFFFF;
    border: 1px solid #C8D2E0;
    border-radius: 10px;
    padding: 10px 16px 10px 40px;
    font-size: 14px;
}

QLineEdit#searchInput:focus {
    border-color: #63C6FF;
    box-shadow: 0 0 0 3px rgba(99, 198, 255, 0.2);
}

QLineEdit#searchInput::placeholder {
    color: #8A95A8;
}

/* Log Card List */
QListWidget#logCardList {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget#logCardList::item {
    background-color: transparent;
    border: none;
    padding: 4px 0;
}

/* =============================================================================
   LOG CARD
   ============================================================================= */

QFrame#logCard {
    background-color: #FFFFFF;
    border: 2px solid transparent;
    border-radius: 14px;
    padding: 12px 16px;
}

QFrame#logCard:hover {
    background-color: #F0F7FF;
    border-color: #E5EAF2;
}

QFrame#logCard[selected="true"] {
    border-color: #63C6FF;
    background-color: #E5F4FF;
}

QFrame#logCard[multiSelected="true"] {
    border-color: #A7E4FF;
    background-color: #F0F7FF;
}

/* Card Header */
QLabel#cardSpeaker {
    font-size: 14px;
    font-weight: 600;
    color: #121826;
}

QLabel#cardOrg {
    font-size: 12px;
    color: #5A6578;
}

QLabel#cardTimestamp {
    font-size: 11px;
    color: #8A95A8;
}

/* Card Body */
QLabel#cardBody {
    font-size: 14px;
    color: #121826;
    line-height: 1.5;
}

/* Card Badges */
QLabel#badge {
    font-size: 10px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 9999px;
}

QLabel#badge[variant="edited"] {
    background-color: #E5F4FF;
    color: #3BA8E8;
}

QLabel#badge[variant="narration"] {
    background-color: #F6F1E6;
    color: #8A95A8;
}

QLabel#badge[variant="lowConf"] {
    background-color: #FFF8E1;
    color: #F5A623;
}

/* Checkbox for multi-select */
QCheckBox#cardCheckbox {
    spacing: 8px;
}

QCheckBox#cardCheckbox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #C8D2E0;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox#cardCheckbox::indicator:checked {
    background-color: #63C6FF;
    border-color: #63C6FF;
}

/* =============================================================================
   RIGHT PANE (書記席 - 詳細/編集)
   ============================================================================= */

QFrame#rightPane {
    background-color: #FFFFFF;
    border-left: 1px solid #E5EAF2;
}

/* Detail Header */
QFrame#detailHeader {
    background-color: #F6F1E6;
    border-radius: 14px;
    padding: 16px;
}

QLabel#detailSpeaker {
    font-size: 18px;
    font-weight: 600;
    color: #121826;
}

QLabel#detailOrg {
    font-size: 14px;
    color: #5A6578;
}

QLabel#detailTimestamp {
    font-size: 12px;
    color: #8A95A8;
}

/* View Tabs */
QTabWidget#viewTabs::pane {
    border: none;
    background-color: #FFFFFF;
}

QTabBar#viewTabBar::tab {
    background-color: transparent;
    border: none;
    padding: 10px 16px;
    font-size: 13px;
    color: #5A6578;
    border-bottom: 2px solid transparent;
}

QTabBar#viewTabBar::tab:selected {
    color: #63C6FF;
    border-bottom-color: #63C6FF;
    font-weight: 500;
}

QTabBar#viewTabBar::tab:hover:!selected {
    color: #121826;
}

/* Editable Text Area */
QTextEdit#editableBody {
    background-color: #FAFAFA;
    border: 1px solid #E5EAF2;
    border-radius: 10px;
    padding: 12px;
    font-size: 14px;
    line-height: 1.6;
}

QTextEdit#editableBody:focus {
    border-color: #63C6FF;
    background-color: #FFFFFF;
}

/* Raw Text (readonly) */
QTextEdit#rawBody {
    background-color: #F6F1E6;
    border: 1px solid #E5EAF2;
    border-radius: 10px;
    padding: 12px;
    font-size: 14px;
    color: #5A6578;
}

/* Diff View */
QTextEdit#diffView {
    background-color: #FFFFFF;
    border: 1px solid #E5EAF2;
    border-radius: 10px;
    padding: 12px;
    font-family: "SF Mono", "Consolas", monospace;
    font-size: 13px;
}

/* Undo/Redo Buttons */
QPushButton#undoButton, QPushButton#redoButton {
    background-color: transparent;
    border: 1px solid #C8D2E0;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    color: #5A6578;
}

QPushButton#undoButton:hover, QPushButton#redoButton:hover {
    background-color: #F0F7FF;
    border-color: #63C6FF;
    color: #121826;
}

QPushButton#undoButton:disabled, QPushButton#redoButton:disabled {
    color: #C8D2E0;
    border-color: #E5EAF2;
}

/* =============================================================================
   COPY PANEL
   ============================================================================= */

QFrame#copyPanel {
    background-color: #F6F1E6;
    border-radius: 14px;
    padding: 16px;
}

/* Format Toggle */
QButtonGroup#formatToggle QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #C8D2E0;
    padding: 8px 16px;
    font-size: 12px;
    color: #5A6578;
}

QButtonGroup#formatToggle QPushButton:first-child {
    border-radius: 8px 0 0 8px;
}

QButtonGroup#formatToggle QPushButton:last-child {
    border-radius: 0 8px 8px 0;
}

QButtonGroup#formatToggle QPushButton:checked {
    background-color: #63C6FF;
    border-color: #63C6FF;
    color: #FFFFFF;
}

/* Copy Button */
QPushButton#copyButton {
    background-color: #63C6FF;
    border: none;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    color: #FFFFFF;
}

QPushButton#copyButton:hover {
    background-color: #3BA8E8;
}

QPushButton#copyButton:pressed {
    background-color: #2A8BC8;
}

QPushButton#copyButton:disabled {
    background-color: #C8D2E0;
    color: #8A95A8;
}

/* =============================================================================
   BUTTONS
   ============================================================================= */

QPushButton#primaryButton {
    background-color: #63C6FF;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 500;
    color: #FFFFFF;
}

QPushButton#primaryButton:hover {
    background-color: #3BA8E8;
}

QPushButton#primaryButton:pressed {
    background-color: #2A8BC8;
}

QPushButton#secondaryButton {
    background-color: transparent;
    border: 1px solid #C8D2E0;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 14px;
    color: #5A6578;
}

QPushButton#secondaryButton:hover {
    background-color: #F0F7FF;
    border-color: #63C6FF;
    color: #121826;
}

QPushButton#dangerButton {
    background-color: transparent;
    border: 1px solid #E53935;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 14px;
    color: #E53935;
}

QPushButton#dangerButton:hover {
    background-color: #FFEBEE;
}

/* =============================================================================
   STATUS BAR
   ============================================================================= */

QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E5EAF2;
    padding: 4px 16px;
}

QStatusBar QLabel {
    font-size: 12px;
    color: #5A6578;
}

/* =============================================================================
   SCROLLBARS
   ============================================================================= */

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background-color: #C8D2E0;
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: #A7E4FF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background-color: #C8D2E0;
    border-radius: 4px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #A7E4FF;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* =============================================================================
   TOOLTIPS
   ============================================================================= */

QToolTip {
    background-color: #0B1B2B;
    color: #EAF2FF;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* =============================================================================
   MENU
   ============================================================================= */

QMenuBar {
    background-color: #0B1B2B;
    color: #EAF2FF;
    padding: 4px 8px;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: rgba(99, 198, 255, 0.2);
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E5EAF2;
    border-radius: 10px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 16px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #E5F4FF;
}

QMenu::separator {
    height: 1px;
    background-color: #E5EAF2;
    margin: 4px 8px;
}

/* =============================================================================
   DIALOGS
   ============================================================================= */

QDialog {
    background-color: #FFFFFF;
}

QDialog QLabel#dialogTitle {
    font-size: 18px;
    font-weight: 600;
    color: #121826;
}

/* =============================================================================
   HALO INDICATOR (特別スタイル - QPainterで描画)
   ============================================================================= */

QWidget#haloIndicator {
    background-color: transparent;
}
